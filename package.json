{
  "name": "grafici-astrologici",
  "version": "0.0.1",
  "private": true,
  "description": "Angular/Three.js astrological chart renderer extracted from VirgoStars; public source pending rights audit",
  "scripts": {
    "build": "ng build grafici-astrologici",
    "build:library": "ng build grafici-astrologici",
    "build:demo": "ng build demo",
    "demo": "ng serve demo --host 127.0.0.1 --port 4200",
    "demo:pack": "node scripts/generate-demo-pack.mjs --out .local/demo-pack",
    "demo:assets": "node scripts/serve-local-assets.mjs --root .local/demo-pack/public/assets --manifest .local/demo-pack/manifests/approved-assets.json",
    "demo:assets:repo": "node scripts/serve-local-assets.mjs --root ../astrological-assets/public/assets --manifest ../astrological-assets/manifests/approved-assets.json",
    "test:demo": "node --test tests/demo-browser.test.mjs",
    "test:demo-interactions": "node --test tests/demo-interactions.browser.test.mjs",
    "benchmark:demo": "node scripts/benchmark-demo.mjs",
    "audit:demo-asset-coverage": "node scripts/audit-demo-asset-coverage.mjs",
    "test:extraction-browser": "node tests/extraction-browser-smoke.mjs",
    "test:offline": "node --test tests/offline-browser.test.mjs",
    "check:types": "tsc -p tsconfig.lib.json --noEmit",
    "check:extraction": "node scripts/check-extraction.mjs",
    "check:assets": "node scripts/inventory-assets.mjs",
    "preflight": "npm run check:extraction && npm run test:extraction && npm run check:assets && npm run check:types && npm run test:assets && npm run test:demo-pack && npm run test:demo-asset-coverage && npm run test:latitude-assets && npm run test:planet-interactions && npm run test:demo-axis-contract && npm run test:demo-axis-invariants && npm run test:demo-axis-projection && npm run test:camera-invariants && npm run test:aspect-identity && npm run test:planet-layout && npm run test:planet-body-groups && npm run test:coordinate-plan && npm run test:coordinate-isolated && npm run test:demo-docs",
    "test:extraction": "node --test tests/extraction-imports.test.mjs",
    "test:asset-urls": "node --test tests/chart-asset-urls.test.mjs",
    "test:asset-manifest": "node --test tests/asset-manifest.test.mjs",
    "test:assets": "npm run test:asset-urls && npm run test:asset-manifest && npm run test:asset-selection && npm run test:local-assets",
    "test:asset-selection": "node --test tests/derive-chart-asset-selection.test.mjs",
    "derive:asset-selection": "node scripts/derive-chart-asset-selection.mjs",
    "dev:assets": "node scripts/serve-local-assets.mjs",
    "test:local-assets": "node --test tests/serve-local-assets.test.mjs",
    "test:demo-pack": "node --test tests/demo-pack.test.mjs",
    "test:demo-asset-coverage": "node --test tests/demo-asset-coverage.test.mjs",
    "test:latitude-assets": "node --test tests/latitude-asset-paths.test.mjs",
    "test:planet-interactions": "node --test tests/planet-interactions.test.mjs tests/natal-palette-reentrancy.test.mjs tests/pointer-transition-reentrancy.test.mjs",
    "demo:generate-synthetic": "node scripts/generate-synthetic-pack.mjs --out .local/synthetic-pack",
    "demo:preview": "node scripts/serve-local-assets.mjs --root .local/synthetic-pack/public/assets --manifest .local/synthetic-pack/manifests/approved-assets.json",
    "test:planet-layout": "node --test tests/planet-layout.test.mjs",
    "test:planet-body-groups": "node --test tests/planet-body-groups.test.mjs",
    "test:coordinate-plan": "node --test tests/chart-coordinate-plan.test.mjs",
    "test:coordinate-isolated": "node --test tests/chart-coordinate-isolated-preview.test.mjs",
    "test:demo-docs": "node --test tests/demo-docs-status.test.mjs",
    "verify:angular": "npm run preflight && npm run build:library && npm run build:demo",
    "test:aspect-identity": "node --test tests/planet-aspect-identity.test.mjs",
    "test:camera-invariants": "node --test tests/chart-camera-invariants.test.mjs",
    "test:demo-axis-contract": "node --test tests/demo-axis-fixture-contract.test.mjs",
    "test:demo-axis-pixels": "node --test tests/axis-focus-canvas.browser.test.mjs",
    "test:demo-axis-invariants": "node --test tests/axis-canvas-invariants.test.mjs",
    "test:demo-axis-pointer": "node --test tests/axis-pointer-hit.browser.test.mjs",
    "test:demo-axis-projection": "node --test tests/axis-pointer-projection.test.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "peerDependencies": {
    "@angular/common": "^20.3.0",
    "@angular/core": "^20.3.0",
    "gsap": "^3.12.5",
    "moment-timezone": "^0.5.46",
    "rxjs": "^7.8.0",
    "three": "^0.170.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.5",
    "@angular/cli": "^20.3.5",
    "@angular/compiler": "^20.3.4",
    "@angular/compiler-cli": "^20.3.4",
    "@angular/platform-browser": "^20.3.35",
    "@types/three": "0.170.0",
    "esbuild": "^0.28.2",
    "ng-packagr": "^20.3.0",
    "playwright-core": "1.56.1",
    "sharp": "^0.34.5",
    "typescript": "5.8.3"
  }
}
